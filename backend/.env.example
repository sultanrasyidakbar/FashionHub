# --- Server ---
PORT=3000

# --- Database lokal (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fashionhub
DB_SSL=false
DB_CA_CERT=
DB_POOL=10

# --- Database Aiven (isi saat deploy) ---
# DB_HOST=pg-xxxxx.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=...
# DB_NAME=defaultdb
# DB_SSL=true
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_POOL=3   (serverless: jaga di bawah max_connections Aiven)

# --- Migrasi dari MySQL lama ---
# Salin seluruh tabel + data dari MySQL ke PostgreSQL:
#   node scripts/migrate-to-postgres.js --mysql .env.mysql --pg .env

# --- Auth ---
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES=1d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
