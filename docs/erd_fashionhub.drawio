idth=2;strokeColor=#5F5E5A;" edge="1" parent="1" source="products_created_by" target="users_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;PK = Primary Key (tebal) &#183; FK = Foreign Key (miring)&lt;br&gt;AI = auto increment &#183; NN = NOT NULL &#183; UQ = UNIQUE&lt;br&gt;Relasi: roles 1-N users, categories 1-N products, users 1-N products (created_by opsional)&lt;br&gt;FK category_id: ON DELETE RESTRICT &#183; FK created_by: ON DELETE SET NULL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#F1EFE8;strokeColor=#B4B2A9;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="300" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>